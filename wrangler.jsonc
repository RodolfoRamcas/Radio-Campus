{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "radio-campus",
  "compatibility_date": "2026-11-01",
  "main": "./worker/index.js",
  "assets": {
    // /pantalla, /votar y /admin son rutas de la aplicación React: se sirve index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "RADIO", "class_name": "Radio" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Radio"] }],
  "observability": { "enabled": true },
  // Secretos (no van aquí): ADMIN_PASSWORD, GEMINI_API_KEY y, opcional, SESSION_SECRET.
  // Se guardan con `npx wrangler secret put NOMBRE` o en Settings → Variables and Secrets.
  "vars": {
    "GEMINI_TTS_MODEL": "gemini-3.8-flash-lite-tts",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
  }
}
